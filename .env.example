# PromptForge configuration
# Every value here is a DEFAULT. Anything you change later in the GUI (Settings)
# is stored in the database and overrides these — no restart needed.
# The app runs fine with this file completely empty: integrations simply show
# "Needs setup" until configured.

# ---- Core ----
# Where the database, media, sessions and knowledge files live.
# In Docker this is the /data volume; leave unset outside Docker to use ./data
#PF_DATA_DIR=/data
#TZ=America/New_York
# Unraid file ownership for /data (container drops to this uid/gid)
#PUID=99
#PGID=100

# ---- Scrapers ----
# Optional: higher rate limits + NSFW access on Civitai
#CIVITAI_API_KEY=
# Comma-separated rotating search terms for the Lexica adapter
#LEXICA_SEARCH_TERMS=cinematic portrait,isometric city,studio product shot

# ---- Knowledge engine LLM (analysis / templates / enhance ONLY) ----
# Provider: anthropic | openai | ollama | companion
#PF_LLM_PROVIDER=
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5
# Any OpenAI-compatible endpoint:
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
# Direct Ollama (or leave provider=companion to use the desktop GPU bridge)
#OLLAMA_BASE_URL=http://host.docker.internal:11434
#OLLAMA_MODEL=llama3.1
# Max LLM calls per day for analysis (ignored for ollama/companion — those are free)
#PF_LLM_DAILY_BUDGET=200

# ---- Generation providers ----
#FAL_API_KEY=
#REPLICATE_API_TOKEN=
#WAVESPEED_API_KEY=

# ---- Baserow ----
#BASEROW_URL=https://api.baserow.io
#BASEROW_TOKEN=
#BASEROW_TABLE_ID=

# ---- Discord ----
#DISCORD_BOT_TOKEN=
#DISCORD_CHANNEL_ID=

# ---- Media compression ----
#PF_IMAGE_QUALITY=82
#PF_IMAGE_MAX_DIM=2048
#PF_VIDEO_CRF=27
#PF_VIDEO_MAX_HEIGHT=1080
#PF_KEEP_ORIGINALS=false
